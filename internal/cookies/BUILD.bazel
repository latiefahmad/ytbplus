load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cookies",
    srcs = [
        "browserjob_other.go",
        "browserjob_windows.go",
        "browsers.go",
        "chromium.go",
        "devtools.go",
        "discover.go",
        "store.go",
        "websocket.go",
        "window.go",
    ],
    importpath = "github.com/latiefahmad/ytbplus/internal/cookies",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/fsutil",
        "//internal/proc",
        "//internal/ytdlp",
    ] + select({
        "@rules_go//go/platform:windows_amd64": [
            "@org_golang_x_sys//windows",
        ],
        "@rules_go//go/platform:windows_arm64": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "cookies_test",
    srcs = [
        "cookies_test.go",
        "window_test.go",
    ],
    embed = [":cookies"],
    deps = ["//internal/proc"],
)

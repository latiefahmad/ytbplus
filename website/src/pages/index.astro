---
import {
  version,
  tag,
  repo,
  releases,
  asset,
  platforms,
  changelog,
} from "../data/releases";

// GitHub Pages serves the site from a subpath, so asset URLs carry it.
const base = import.meta.env.BASE_URL;
const url = (path: string) => `${base}${path}`.replace(/\/{2,}/g, "/");
const site = new URL(base, import.meta.env.SITE).href;

const nav = [
  { href: "#features", label: "Features" },
  { href: "#download", label: "Download" },
  { href: "#changelog", label: "Changelog" },
  { href: "#faq", label: "FAQ" },
];

// Real 1.0 screenshots. Ratios: home 1171x755, lyrics 1171x760.
const heroShots = {
  main: { src: url("/assets/screens/home.webp"), alt: "The ytbplus Home screen in the dark theme", w: 1171, h: 755 },
  side: { src: url("/assets/screens/lyrics.webp"), alt: "The player with synced lyrics", w: 1171, h: 760 },
};

const features = [
  {
    title: "Native, not a tab",
    body: "ytbplus draws its own window instead of loading the YouTube Music web page. It idles at about 100 MB of memory, where the site in a tab takes 600 to 800.",
    icon: "gauge",
    tile: "#E9DDFF",
  },
  {
    title: "Lyrics that keep up",
    body: "Synced lyrics light each line as it is sung, from Better Lyrics, YouTube Music or LRCLIB. Switch to plain text when you prefer it.",
    icon: "lyrics",
    tile: "#D9F2E6",
  },
  {
    title: "Colours from the art",
    body: "The whole interface takes its palette from the album art of the song playing. Matugen can take over, so ytbplus matches the rest of your desktop.",
    icon: "palette",
    tile: "#FFE8A3",
  },
  {
    title: "Your account, your library",
    body: "Sign in with the browser you already use, never an email or password. Like songs, follow artists, save albums, and sort or search your own playlists.",
    icon: "library",
    tile: "#FFD9EC",
  },
  {
    title: "Downloads that stick",
    body: "Save songs, videos and playlists to disk and queue them for later. They keep their thumbnails and play like any other track.",
    icon: "download",
    tile: "#D6E9FF",
  },
  {
    title: "Last.fm, stats, Discord",
    body: "Scrobble as you listen and pause it any time. See your listening time by day, kept on your computer, and show the current track on Discord.",
    icon: "pulse",
    tile: "#FFE1D0",
  },
];

const compare = [
  ["Memory", "~100 MB", "600–800 MB"],
  ["Ads from the web page", "none", "shown"],
  ["Synced lyrics", "built in", "limited"],
  ["Colours from the album art", "built in", "—"],
  ["Last.fm scrobbling", "built in", "extension"],
];

const faq = [
  {
    q: "Is ytbplus official?",
    a: "No. ytbplus is an independent project, not made, endorsed or supported by YouTube or Google. It uses YouTube's private web interfaces, which YouTube can change at any time.",
  },
  {
    q: "What happens when YouTube changes something?",
    a: "Browsing, playback or sign-in can stop working until a new release ships. The app checks for updates once a day, and you can update by hand from the releases page.",
  },
  {
    q: "Do I need an account?",
    a: "No. Browsing and playback work without signing in. Signing in adds your personalised Home feed and Library.",
  },
  {
    q: "What is a minimal build?",
    a: "The full build bundles ffmpeg, yt-dlp and QuickJS. The minimal build uses the ffmpeg, yt-dlp and Node.js or Bun already on your system, for a smaller download.",
  },
  {
    q: "Is it really free?",
    a: "Yes, under the GNU General Public License v3.0. There are no ads, no tracking and no paid tier. Donations are a thank-you, never a subscription.",
  },
];

const kindLabel = { Added: "Added", Changed: "Changed", Fixed: "Fixed", Removed: "Removed" } as const;

const icons: Record<string, string> = {
  gauge: '<path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="m14.1 11.9 3.9-3.9"/><path d="M20.2 16.6A8 8 0 1 0 3.8 16.6"/>',
  lyrics: '<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
  palette: '<path d="M12 3a9 9 0 1 0 0 18 2 2 0 0 0 1.6-3.2 2 2 0 0 1 1.6-3.2H18a3 3 0 0 0 3-3.1A8.9 8.9 0 0 0 12 3Z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7.5" r="1"/><circle cx="14.5" cy="7.5" r="1"/>',
  library: '<path d="M4 5v14"/><path d="M9 4v16"/><rect x="13" y="4" width="7" height="16" rx="1.5"/>',
  pulse: '<path d="M3 12h4l2.5-7 4 14L16 12h5"/>',
  download: '<path d="M12 3v11M7.5 10.5 12 15l4.5-4.5M5 19h14"/>',
};

const marquee = ["~100 MB memory", "No ads", "Synced lyrics", "Colours per song", "Last.fm scrobbling", "Downloads", "Discord presence", "Free & open source"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ytbplus · YouTube Music, without the bloat</title>
    <meta
      name="description"
      content="A free, native desktop player for YouTube Music. About 100 MB of memory, no ads, synced lyrics and colours from the album art. For macOS, Windows and Linux."
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14121a" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={site} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content="ytbplus · YouTube Music, without the bloat" />
    <meta
      property="og:description"
      content="A free, native desktop player for YouTube Music. About 100 MB of memory, no ads, synced lyrics."
    />
    <meta property="og:image" content={url("/assets/og.jpg")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url("/favicon.ico")} sizes="48x48" />
    <link rel="icon" href={url("/assets/brand/icon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/assets/favicon-64.png")} sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href={url("/assets/apple-touch-icon.png")} />
    <link rel="manifest" href={url("/site.webmanifest")} />
    <link rel="preload" href={url("/assets/fonts/GoogleSans.woff2")} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:"Google Sans";font-weight:100 900;font-display:swap;src:url("${url("/assets/fonts/GoogleSans.woff2")}") format("woff2")}`}></style>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored;
        try { stored = localStorage.getItem("ytbplus-theme"); } catch (e) {}
        var dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = dark ? "dark" : "light";
        root.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={base} aria-label="ytbplus home">
          <span class="brand-badge"><img src={url("/assets/brand/icon.svg")} alt="" width="26" height="20" /></span>
          <span>ytbplus</span>
        </a>
        <nav aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="head-actions">
          <a class="btn btn-yellow head-cta" href="#download">Download</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="sun"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="moon"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-inner">
          <a class="sticker" href="#changelog">
            <span class="sticker-dot" aria-hidden="true"></span>
            v{version}
            <span class="sticker-link">What changed →</span>
          </a>

          <h1 id="hero-title">
            YouTube Music,<br />
            <em>without the bloat.</em>
          </h1>

          <p class="lede">
            A native desktop player that draws its own window instead of loading
            the web page. About 100&nbsp;MB of memory, no ads, synced lyrics,
            and colours taken from the album art.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#download" data-hero-download>Download ytbplus</a>
            <a class="btn btn-plain" href={repo}>
              <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
              Source
            </a>
          </div>

          <div class="hero-stage">
            <figure class="shot shot-main">
              <img
                src={heroShots.main.src}
                alt={heroShots.main.alt}
                width={heroShots.main.w}
                height={heroShots.main.h}
                fetchpriority="high"
              />
            </figure>
            <figure class="shot shot-mini">
              <img
                src={heroShots.side.src}
                alt={heroShots.side.alt}
                width={heroShots.side.w}
                height={heroShots.side.h}
                loading="lazy"
              />
            </figure>
          </div>
        </div>

        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {[0, 1].map(() => marquee.map((item) => <span>{item}<i>✦</i></span>))}
          </div>
        </div>
      </section>

      <section class="compare" aria-labelledby="compare-title">
        <div class="wrap">
          <h2 id="compare-title" class="sr-only">ytbplus compared with the browser</h2>
          <div class="compare-card">
            <div class="compare-head">
              <span></span>
              <span class="c-ytb">ytbplus</span>
              <span class="c-web">In a browser tab</span>
            </div>
            {compare.map(([label, a, b]) => (
              <div class="compare-row">
                <span class="c-label">{label}</span>
                <span class="c-ytb">{a}</span>
                <span class="c-web">{b}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="features" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <h2 id="features-title">Everything the web app is missing,<br />at a tenth of the memory.</h2>
          <div class="feature-grid">
            {features.map((f) => (
              <article class="feature" style={`--tile:${f.tile}`}>
                <span class="feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icons[f.icon]}></svg>
                </span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="download" id="download" aria-labelledby="download-title">
        <div class="wrap">
          <h2 id="download-title">Get ytbplus {version}</h2>
          <p class="section-lede">
            Free and open source. Every build is made by CI from the source on
            GitHub, so you can check what you run.
          </p>

          <div class="dl-list" data-platforms>
            {platforms.map((p, index) => (
              <article class="dl-card" data-platform={p.id} style={`--i:${index}`}>
                <div class="dl-main">
                  <header>
                    <span class="dl-os" aria-hidden="true">
                      {p.id === "mac" && (
                        <svg viewBox="0 0 24 24"><path d="M16.4 12.7c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.8-1.4 0-2.8.8-3.5 2.1-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.5 2.2 2.6 2.1 1-.04 1.4-.7 2.7-.7s1.6.7 2.7.6c1.1-.02 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4-.02-.01-2.1-.8-2.1-3.3ZM14.4 6.3c.6-.7 1-1.7.9-2.7-.8.03-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6.9.07 1.9-.5 2.5-1.2Z"></path></svg>
                      )}
                      {p.id === "win" && (
                        <svg viewBox="0 0 24 24"><path d="M3 5.6 10.3 4.6v7H3V5.6Zm0 12.8 7.3 1v-6.9H3v5.9Zm8.2 1.1L21 21V12.7h-9.8v6.8Zm0-15v6.9H21V3l-9.8 1.5Z"></path></svg>
                      )}
                      {p.id === "linux" && (
                        <svg viewBox="0 0 24 24"><path d="M12 2.5c-2 0-3.1 1.7-3 3.7.06 1.3-.1 2.5-.8 3.7-.5.9-1.2 1.8-1.6 2.9-.4 1.1-.3 2.4.2 3.4.4.9 1.1 1.6 1.4 2.5.3.9.9 1.5 1.9 1.6 1.6.2 3.2.2 4.8 0 1-.1 1.6-.7 1.9-1.6.3-.9 1-1.6 1.4-2.5.5-1 .6-2.3.2-3.4-.4-1.1-1.1-2-1.6-2.9-.7-1.2-.9-2.4-.8-3.7.1-2-1-3.7-3-3.7Z"></path><ellipse cx="10.3" cy="7.4" rx=".8" ry="1.1" fill="var(--card)"></ellipse><ellipse cx="13.7" cy="7.4" rx=".8" ry="1.1" fill="var(--card)"></ellipse></svg>
                      )}
                    </span>
                    <div class="dl-title">
                      <h3>{p.name}</h3>
                      <p>{p.note}</p>
                    </div>
                    <span class="dl-badge" data-badge hidden>Your system</span>
                  </header>

                  <a class="btn btn-primary dl-btn" href={asset(p.primary.file)} data-primary>
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="dl-icon"><path d="M12 3v11M7.5 10.5 12 15l4.5-4.5M5 19h14"></path></svg>
                    <span>{p.primary.label}</span>
                    <small>{p.primary.hint}</small>
                  </a>

                  <ul class="dl-others">
                    {p.others.map((o) => (
                      <li><a href={asset(o.file)}>{o.label}</a></li>
                    ))}
                  </ul>
                </div>

                <ol class="dl-steps">
                  {p.steps.map((s) => <li>{s}</li>)}
                </ol>
              </article>
            ))}
          </div>

          <p class="dl-foot">
            Every release also has full and minimal builds, plus a{" "}
            <a href={`${releases}/tag/${tag}`}>checksums file</a> to verify the
            download. Old versions stay on the <a href={releases}>releases page</a>.
          </p>
        </div>
      </section>

      <section class="changelog" id="changelog" aria-labelledby="changelog-title">
        <div class="wrap">
          <h2 id="changelog-title">What changed</h2>
          <p class="section-lede">
            The current release is <strong>{version}</strong>. Read the{" "}
            <a href={`${repo}/blob/main/CHANGELOG.md`}>full changelog</a> for
            every detail.
          </p>

          <ol class="log">
            {changelog.map((entry, i) => (
              <li class:list={["log-entry", { current: i === 0 }]}>
                <div class="log-head">
                  <h3>
                    {entry.version}
                    {i === 0 && <span class="tag-current">Current</span>}
                  </h3>
                  <time>{entry.date}</time>
                </div>
                {entry.changes.map((group) => (
                  <div class="log-group">
                    <span class:list={["kind", `kind-${group.kind.toLowerCase()}`]}>
                      {kindLabel[group.kind]}
                    </span>
                    <ul>
                      {group.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                ))}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="support" aria-labelledby="support-title">
        <div class="wrap">
          <div class="support-card">
            <div>
              <h2 id="support-title">If it earns a place in your day.</h2>
              <p>
                ytbplus is free: no ads, no tracking, no paid tier. If it saves
                you a browser tab, you can buy me a coffee. A thank-you, not a
                subscription — nothing is locked behind it.
              </p>
            </div>
            <a class="btn btn-yellow btn-big" href="https://saweria.co/latiefahmad">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="coffee"><path d="M4 8h12v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"></path><path d="M16 9h1.5a2.5 2.5 0 0 1 0 5H16"></path><path d="M6.5 3.5c0 .8.9.8.9 1.6M10 3.5c0 .8.9.8.9 1.6M13.5 3.5c0 .8.9.8.9 1.6"></path></svg>
              <span>Buy me a coffee<small>saweria.co/latiefahmad</small></span>
            </a>
          </div>
        </div>
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-title">
        <div class="wrap">
          <h2 id="faq-title">Good to know</h2>
          <div class="faq-list">
            {faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-cta">
          <img src={url("/assets/brand/icon.svg")} alt="" width="52" height="40" />
          <h2>Put your music on the desktop.</h2>
          <p>Free, open source, and about a tenth of a browser tab.</p>
          <a class="btn btn-yellow" href="#download" data-hero-download>Download ytbplus</a>
        </div>

        <div class="foot-grid">
          <div class="foot-col foot-about">
            <div class="foot-brand">
              <img src={url("/assets/brand/icon.svg")} alt="" width="26" height="20" />
              <strong>ytbplus</strong>
            </div>
            <p>
              A native desktop player for YouTube Music, made by
              <a href="https://github.com/latiefahmad"> latiefahmad</a> and
              contributors.
            </p>
            <p class="foot-fine">
              GPL-3.0. YouTube is a trademark of Google LLC; this project is
              not endorsed by or connected to it.
            </p>
          </div>
          <nav class="foot-col" aria-label="Project">
            <h3>Project</h3>
            <a href={repo}>Source code</a>
            <a href={releases}>Releases</a>
            <a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
            <a href={`${repo}/blob/main/LICENSE`}>License</a>
          </nav>
          <nav class="foot-col" aria-label="Help">
            <h3>Help</h3>
            <a href="#faq">Questions</a>
            <a href={`${repo}/issues`}>Report a problem</a>
            <a href={`${repo}/discussions`}>Discussions</a>
            <a href="#download">Download</a>
          </nav>
          <div class="foot-col">
            <h3>Support</h3>
            <p class="foot-support-text">If it earns a place in your day, a coffee helps it keep going.</p>
            <a class="btn btn-yellow btn-saweria" href="https://saweria.co/latiefahmad">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="coffee"><path d="M4 8h12v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"></path><path d="M16 9h1.5a2.5 2.5 0 0 1 0 5H16"></path><path d="M6.5 3.5c0 .8.9.8.9 1.6M10 3.5c0 .8.9.8.9 1.6M13.5 3.5c0 .8.9.8.9 1.6"></path></svg>
              <span>Saweria<small>latiefahmad</small></span>
            </a>
          </div>
        </div>

        <div class="foot-base">
          <p>© {new Date().getFullYear()} latiefahmad. Not affiliated with YouTube or Google.</p>
          <a href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <script>
      /* Theme: follow the system until the visitor picks one. */
      const root = document.documentElement;

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem("ytbplus-theme", root.dataset.theme);
      });

      /* Put the visitor's own platform first and label it. */
      function detectOS() {
        const nav = navigator;
        const platform = nav.userAgentData?.platform || navigator.platform || "";
        const agent = navigator.userAgent || "";
        if (/mac/i.test(platform) || /Mac OS X/.test(agent)) return "mac";
        if (/win/i.test(platform) || /Windows/.test(agent)) return "win";
        if (/linux|x11/i.test(platform) || /Linux|Android/.test(agent)) return "linux";
        return null;
      }

      const os = detectOS();
      if (os) {
        const card = document.querySelector(`[data-platform="${os}"]`);
        if (card) {
          card.classList.add("is-yours");
          card.querySelector("[data-badge]")?.removeAttribute("hidden");
          card.parentElement?.prepend(card);
          const label = card.querySelector("[data-primary] span");
          if (label) label.textContent = `Download for ${card.querySelector("h3").textContent}`;
        }
        const names = { mac: "macOS", win: "Windows", linux: "Linux" };
        for (const hero of document.querySelectorAll("[data-hero-download]")) {
          hero.textContent = `Download for ${names[os]}`;
        }
      }

      /* Reveal cards as they come into view. */
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        const targets = document.querySelectorAll(".feature, .dl-card, .log-entry");
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        for (const target of targets) io.observe(target);

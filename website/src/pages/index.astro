        display: block; width: fit-content;
      }
      .foot-col nav a { padding: 5px 0; font-size: 14.5px; text-decoration: none; }
      .foot-support-text { max-width: 30ch; }
      .foot-saweria { white-space: nowrap; }

      .foot-base {
        display: flex; justify-content: space-between; align-items: center; gap: 16px;
        padding-top: 24px; border-top: 2px dashed #3a3648;
        font-size: 13px; color: #a89fbd;
      }
      .foot-base a { color: #a89fbd; text-decoration: none; font-weight: 700; }
      .foot-base a:hover { color: #f2effa; }

      /* ---------- reveal ---------- */
      .feature, .dl-card, .log-entry { opacity: 1; }
      .js .feature, .js .dl-card, .js .log-entry {
        opacity: 0; transform: translateY(18px);
        transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .js .feature.in, .js .dl-card.in, .js .log-entry.in { opacity: 1; transform: none; }

      /* ---------- responsive ---------- */
      @media (max-width: 1000px) {
        .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .dl-card { grid-template-columns: 1fr; }
        .support-card { grid-template-columns: 1fr; }
        .support-card .btn-big { justify-self: start; }
        .foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (max-width: 760px) {
        body { font-size: 16px; }
        :root { --head: 62px; --bw: 2.5px; }
        .wrap { width: calc(100% - 32px); }
        .head-inner nav { display: none; }
        .feature-grid { grid-template-columns: 1fr; }
        .compare-head, .compare-row { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr) minmax(0, 0.9fr); gap: 8px; }
        .compare-row .c-web { font-size: 13.5px; }
        .log-group { grid-template-columns: 1fr; gap: 8px; }
        .kind { justify-self: start; }
        .dl-btn small { display: none; }
        .log-head h3::before { display: none; }
        .log-entry { padding-left: 14px; }
        .shot-mini { display: none; }
        .hero-stage { padding-bottom: 0; }
      }
      @media (max-width: 460px) {
        .head-cta { display: none; }
        .hero-actions .btn { width: 100%; }
        .foot-grid { grid-template-columns: 1fr; gap: 28px; }
        .foot-base { flex-direction: column; align-items: flex-start; gap: 8px; }
        .foot-saweria { width: 100%; justify-content: center; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation: none !important; transition-duration: 0.01ms !important; }
        .js .feature, .js .dl-card, .js .log-entry { opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
